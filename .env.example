# ------------------------------------------------------------------------------
# Root Environment Template — Demilew Portfolio Platform
# Copy to `.env` or appropriate subdirectory `.env` files for local development.
# Never commit `.env` containing sensitive credentials to version control.
# ------------------------------------------------------------------------------

# Database (PostgreSQL 16 via Docker Compose)
POSTGRES_DB=demilew_portfolio
POSTGRES_USER=demilew_app
POSTGRES_PASSWORD=replace-with-a-secure-local-password
POSTGRES_PORT=5432

# Backend (FastAPI)
DATABASE_URL=postgresql+psycopg2://demilew_app:replace-with-a-secure-local-password@localhost:5432/demilew_portfolio
SECRET_KEY=replace-with-a-secure-random-secret-key-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
APP_ENV=development
DEBUG=true

# Frontend (Next.js)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
